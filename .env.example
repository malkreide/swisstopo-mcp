# Example environment configuration for swisstopo-mcp.
# Copy to `.env` (git-ignored) and adjust. None of these are secrets — the
# server uses only key-less public APIs — but the file documents the knobs.

# Comma-separated cantonal OEREB endpoints to enable (e.g. "ZH,BE").
SWISSTOPO_OEREB_CANTONS=ZH

# HTTP transport (only used with `--http`). Bind 127.0.0.1 locally; a container
# sets 0.0.0.0 itself. Never commit a real 0.0.0.0 default in code (SEC-016).
SWISSTOPO_HTTP_HOST=127.0.0.1
SWISSTOPO_HTTP_PORT=8000

# Comma-separated CORS origins for browser MCP clients (no wildcard).
SWISSTOPO_ALLOWED_ORIGINS=

# Comma-separated Host header values this server answers MCP requests on.
# Required behind a proxy/ingress: the MCP SDK's DNS-rebinding protection
# rejects unknown Host headers with 421, and its default list is loopback
# only. Loopback (incl. any port) is always allowed, so leave this empty for
# local use and set the public hostname when deploying.
SWISSTOPO_ALLOWED_HOSTS=

# DNS pinning (SEC-005). Connects to the address the SSRF guard already vetted,
# keeping SNI and the Host header on the hostname so TLS is unaffected. OFF by
# default: it rewrites the target of every outbound request, and it is inert
# behind a forward proxy (the proxy resolves the name itself). Verify in your
# environment before enabling.
SWISSTOPO_PIN_DNS=false

# Log level: DEBUG | INFO | WARNING | ERROR
SWISSTOPO_LOG_LEVEL=INFO

# --- OpenTelemetry tracing (OBS-006) ---
# Tracing is OFF unless OTEL_EXPORTER_OTLP_ENDPOINT is set — the local stdio
# workflow pays nothing and emits nothing. Note these use the standard OTEL_
# prefix, not SWISSTOPO_, so any OTel tooling picks them up unchanged.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=swisstopo-mcp
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
